# ==========================================================================
# Self-hostable Language Learning Platform - environment template
# Copy to `.env` and fill real values. NEVER commit `.env`.
# The platform runs fully WITHOUT any paid AI/OCR service (local-first).
# ==========================================================================

# ---- App identity (overridable at runtime via Admin Settings) ----
APP_ENV=development
# Public origin of the frontend, used for CORS + cookie scoping
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Absolute base URL the API is reachable at from the browser
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ---- Security secrets (generate with: openssl rand -hex 32) ----
# Signs session cookies
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32
# CSRF token signing key
CSRF_SECRET=CHANGE_ME_openssl_rand_hex_32
# Cookie security: set true in production behind TLS
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---- Sessions ----
ADMIN_SESSION_TTL_HOURS=12
STUDENT_SESSION_TTL_HOURS=72

# ---- PostgreSQL ----
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://app:change-me-strong-password@localhost:5432/app
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---- Redis (cache, queues, presence, background jobs) ----
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_PORT=6379

# ---- Object storage (S3/MinIO compatible) ----
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=platform-media
OBJECT_STORAGE_SECURE=false
# Default max imported video size (MB)
MAX_VIDEO_UPLOAD_MB=700
MAX_FILE_UPLOAD_MB=700

# ---- Bootstrap admin (created by seed on first run; changeable later) ----
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password

# ---- Interface + learning languages ----
# Enabled UI languages (comma separated). Supported pool: az,en,ru,tr
ENABLED_UI_LANGUAGES=az,en,ru,tr
DEFAULT_UI_LANGUAGE=en
# Learning languages available for content (comma separated ISO-style codes)
LEARNING_LANGUAGES=en
# Translation target languages for vocabulary
TRANSLATION_LANGUAGES=az,ru,tr

# ---- AI / OCR / STT / Translation providers (all optional, local-first) ----
# One of: none | local | gemini
AI_PROVIDER=none
# Local OpenAI-compatible endpoint (Ollama etc.)
LOCAL_AI_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_AI_MODEL=llama3.1
# Gemini is OPTIONAL; only used when teacher supplies a key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OCR_PROVIDER=none            # none | paddleocr | tesseract
STT_PROVIDER=none             # none | whisper
TRANSLATION_PROVIDER=none     # none | libretranslate
TRANSLATION_BASE_URL=http://localhost:5000
DICTIONARY_PROVIDER=none      # none | kaikki

# ---- Background jobs / imports ----
IMPORT_AUTO_MODE_DEFAULT=false
IMPORT_LOW_CONFIDENCE_THRESHOLD=0.80

# ---- Retention & backups ----
TRASH_RETENTION_DAYS=30
ACTIVITY_RETENTION_DAYS=0     # 0 = permanent
BACKUP_ENABLED=false
BACKUP_CRON=03:00
